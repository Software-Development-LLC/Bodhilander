{
  "name": "bodhilander-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant cloud relay for Bodhilander remote hosting",
  "module": "src/index.ts",
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run build:web && bun --watch src/index.ts",
    "build:web": "bun build web/src/main.ts --outdir web/dist --target browser --minify",
    "test": "bun test --isolate",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "^6.0.0"
  }
}
