# Bodhilander relay configuration.
# Copy to `.env` (docker compose picks it up automatically) or export in the shell.

# Port the HTTP/WebSocket server listens on.
PORT=8080

# Public base URL of this relay (no trailing slash); used for absolute links.
PUBLIC_URL=http://localhost:8080

# SQLite database file; the parent directory is created automatically.
DB_PATH=./data/relay.db

# Secret for signing session tokens. REQUIRED when NODE_ENV=production — the
# server refuses to start without it. Generate: openssl rand -hex 32
SESSION_SECRET=

# Log level: debug | info | warn | error.
LOG_LEVEL=info

# Trust X-Forwarded-* headers (set true when behind a TLS-terminating proxy /
# load balancer in front of the container).
TRUST_PROXY=false

# Extra allowed web origins, comma-separated; empty = same-origin only.
ALLOWED_ORIGINS=

# Lifetime of a machine-linking code, in seconds.
LINK_CODE_TTL_SECONDS=600

# Machine handoff: how long a prepared bundle stays available, the ceiling on
# one bundle, and the ceiling on the whole store. Bundles are written to
# handoffs/ beside DB_PATH, so the disk behind that path needs the store size.
HANDOFF_TTL_SECONDS=604800
HANDOFF_MAX_BYTES=268435456
HANDOFF_STORE_MAX_BYTES=8589934592
# Override only if bundles should not live beside the database.
HANDOFF_DIR=

# GitHub OAuth app credentials — used by Milestone 2, optional for now.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# If set, only ACTIVE members of this GitHub org may sign in (empty = anyone
# with a GitHub account). Requesting the read:org scope is handled automatically
# when this is set. Example: Software-Development-LLC
ALLOWED_GITHUB_ORG=

# Contact URI embedded in VAPID claims for web push (mailto: or https:).
VAPID_SUBJECT=mailto:admin@localhost

# Node environment: development | production.
NODE_ENV=development
