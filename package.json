{
  "name": "bodhilander",
  "version": "3.5.1-beta.4",
  "description": "Cross-platform Claude Code session manager",
  "homepage": "https://github.com/Software-Development-LLC/Bodhilander",
  "author": {
    "name": "Will Long II",
    "email": "sytanek@gmail.com"
  },
  "contributors": [
    {
      "name": "Claude (Anthropic)",
      "email": "noreply@anthropic.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Software-Development-LLC/Bodhilander.git"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "postinstall": "electron-rebuild -o better-sqlite3,node-pty && node node_modules/node-pty/scripts/post-install.js",
    "build:main": "tsc -p tsconfig.main.json",
    "build:hooks": "esbuild src/hooks/bodhilander-hook.ts --bundle --platform=node --target=node18 --outfile=dist/hooks/bodhilander-hook.js --sourcemap --format=cjs",
    "build:renderer": "webpack --mode production",
    "build:pwa": "vite build --config src/pwa/vite.config.ts",
    "dev:pwa": "vite --config src/pwa/vite.config.ts",
    "build": "bun run build:main && bun run build:hooks && bun run build:renderer && bun run build:pwa",
    "start": "bun run build && electron .",
    "dev": "bun run build && electron .",
    "clean:db": "node -e \"const p=require('path'),f=require('fs'),d=p.join(process.env.APPDATA||process.env.HOME,'bodhilander');['bodhilander.db','bodhilander.db-shm','bodhilander.db-wal'].forEach(n=>{const fp=p.join(d,n);try{f.unlinkSync(fp);console.log('Deleted:',fp)}catch(e){if(e.code!=='ENOENT')console.error('Failed:',fp,e.message)}})\"",
    "dev:clean": "bun run clean:db && bun run dev",
    "pack": "bun run build && electron-builder --dir",
    "dist": "bun run build && electron-builder",
    "dist:mac": "bun run build && electron-builder --mac",
    "dist:win": "bun run build && electron-builder --win",
    "dist:linux": "bun run build && electron-builder --linux"
  },
  "keywords": [],
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "better-sqlite3": "^12.5.0",
    "bonjour-service": "^1.3.0",
    "cors": "^2.8.5",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "idb": "^8.0.0",
    "node-pty": "^1.1.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-is": "^19.2.7",
    "react-router-dom": "^7.1.1",
    "recharts": "^3.8.1",
    "web-push": "^3.6.7",
    "ws": "^8.19.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-webgl": "^0.16.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@happy-dom/global-registrator": "^20.11.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.0",
    "html-webpack-plugin": "^5.6.5",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "build": {
    "extends": "electron-builder.yml"
  }
}
