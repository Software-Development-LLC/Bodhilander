{
  "name": "bodhilander",
  "version": "3.3.2-beta.0",
  "description": "Cross-platform Claude Code session manager",
  "homepage": "https://github.com/Software-Development-LLC/Bodhilander",
  "author": {
    "name": "Will Long II",
    "email": "sytanek@gmail.com"
  },
  "contributors": [
    {
      "name": "Claude (Anthropic)",
      "email": "noreply@anthropic.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Software-Development-LLC/Bodhilander.git"
  },
  "main": "dist/main/index.js",
  "bin": {
    "bodhilander-memory-server": "./dist/mcp-server/index.js"
  },
  "scripts": {
    "postinstall": "electron-rebuild -o better-sqlite3,sodium-native,sqlite-vec,node-pty && node node_modules/node-pty/scripts/post-install.js",
    "build:main": "tsc -p tsconfig.main.json",
    "build:worker": "esbuild src/main/vector-search/indexing-worker.ts --bundle --platform=node --target=node18 --outfile=dist/main/vector-search/indexing-worker.js --sourcemap --format=cjs --external:tree-sitter --external:'tree-sitter-*' --external:onnxruntime-node --external:onnxruntime-common --alias:sharp=./src/main/vector-search/sharp-stub.js",
    "build:mcp": "esbuild src/mcp-server/index.ts --bundle --platform=node --target=node18 --outfile=dist/mcp-server/index.js --sourcemap --format=cjs",
    "build:hooks": "esbuild src/hooks/bodhilander-hook.ts --bundle --platform=node --target=node18 --outfile=dist/hooks/bodhilander-hook.js --sourcemap --format=cjs",
    "build:renderer": "webpack --mode production",
    "build": "bun run build:main && bun run build:worker && bun run build:mcp && bun run build:hooks && bun run build:renderer",
    "start": "bun run build && electron .",
    "dev": "bun run build && electron .",
    "clean:db": "node -e \"const p=require('path'),f=require('fs'),d=p.join(process.env.APPDATA||process.env.HOME,'bodhilander');['bodhilander.db','bodhilander.db-shm','bodhilander.db-wal'].forEach(n=>{const fp=p.join(d,n);try{f.unlinkSync(fp);console.log('Deleted:',fp)}catch(e){if(e.code!=='ENOENT')console.error('Failed:',fp,e.message)}})\"",
    "dev:clean": "bun run clean:db && bun run dev",
    "pack": "bun run build && electron-builder --dir",
    "dist": "bun run build && electron-builder",
    "dist:mac": "bun run build && electron-builder --mac",
    "dist:win": "bun run build && electron-builder --win",
    "dist:linux": "bun run build && electron-builder --linux"
  },
  "keywords": [],
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@huggingface/transformers": "^3.4.1",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "better-sqlite3": "^12.5.0",
    "bonjour-service": "^1.3.0",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ignore": "^7.0.4",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "recharts": "^3.8.1",
    "react-dom": "^19.2.3",
    "socket.io-client": "^4.8.3",
    "sodium-native": "^5.0.10",
    "sqlite-vec": "^0.1.6",
    "tree-sitter": "^0.22.4",
    "tree-sitter-c-sharp": "^0.23.1",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-python": "^0.23.6",
    "tree-sitter-typescript": "^0.23.2",
    "ws": "^8.19.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-webgl": "^0.16.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/sodium-native": "^2.3.9",
    "@types/ws": "^8.18.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.0",
    "html-webpack-plugin": "^5.6.5",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "build": {
    "extends": "electron-builder.yml"
  }
}
